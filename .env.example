# ============================================================
# MairIA - Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs
# ============================================================

# --- API Mistral (obligatoire) ---
# Cle API obtenue sur https://console.mistral.ai
MISTRAL_API_KEY=

# Modeles Mistral
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed

# --- Supabase (obligatoire) ---
# IMPORTANT : utiliser un projet Supabase en region EU (Francfort ou Paris)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL de connexion directe PostgreSQL (pour les migrations et le backend)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- Securite (obligatoire) ---
# Secret pour signer les tokens JWT (generer avec : openssl rand -hex 32)
JWT_SECRET=
# Duree de validite des tokens en minutes
JWT_EXPIRATION_MINUTES=480

# --- CORS ---
# Origines autorisees, separees par des virgules
# En dev : http://localhost:3000
# En prod : ajouter les domaines des mairies clientes
CORS_ORIGINS=http://localhost:3000

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- RAG Configuration ---
# Taille des chunks de texte (en caracteres)
CHUNK_SIZE=1000
# Chevauchement entre chunks
CHUNK_OVERLAP=200
# Nombre de chunks retournes par recherche semantique
RAG_TOP_K=5
# Score minimum de similarite (0.0 a 1.0)
RAG_SIMILARITY_THRESHOLD=0.3

# --- Stockage fichiers ---
# Taille max d'upload en Mo
MAX_UPLOAD_SIZE_MB=20

# --- Logging ---
# Activer le log des conversations (opt-in RGPD)
LOG_CONVERSATIONS=false
LOG_LEVEL=INFO
